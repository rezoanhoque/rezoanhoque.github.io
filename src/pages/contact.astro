---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, profiles } from '../data/site';
---
<Layout title="Contact" description="How to reach M. R. Hoque.">
  <section class="page-head">
    <div class="wrap narrow">
      <h1>Contact</h1>
      <p class="sub">I welcome questions about my research, collaborations and teaching. Email is the best way to reach me.</p>
    </div>
  </section>

  <div class="wrap narrow page-body">
    <div class="contact-grid">
      <div class="card">
        <div class="c-item">
          <span class="c-ic"><Icon name="mail" size={20} /></span>
          <div><p class="c-label">Email</p><p class="c-val"><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
        </div>
        <div class="c-item">
          <span class="c-ic"><Icon name="building" size={20} /></span>
          <div>
            <p class="c-label">Affiliation</p>
            <p class="c-val">{site.department}</p>
            <p class="c-val">{site.school}</p>
          </div>
        </div>
        <div class="c-item">
          <span class="c-ic"><Icon name="pin" size={20} /></span>
          <div><p class="c-label">Address</p>{site.address.map((l) => <p class="c-val">{l}</p>)}</div>
        </div>
      </div>
      <div class="card">
        <p class="c-label" style="margin-bottom:14px">Academic profiles</p>
        {profiles.map((p) => (
          <div class="c-item">
            <span class="c-ic"><Icon name={p.icon} size={19} /></span>
            <div><p class="c-label">{p.label}</p><p class="c-val"><a href={p.url}>{p.handle}</a></p></div>
          </div>
        ))}
        <div class="hero-actions" style="margin-top:24px">
          <a class="btn btn-primary" href={site.cv} download><Icon name="download" size={17} /> Download CV</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import { photos } from '../data/gallery';

const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.jpg', { eager: true });
---
<Layout title="Gallery" description="Conferences, talks, posters and milestones.">
  <section class="page-head">
    <div class="wrap">
      <h1>Gallery</h1>
      <p class="sub">Conferences, talks, posters, awards and milestones.</p>
    </div>
  </section>

  <div class="wrap page-body">
    <div class="gallery">
      {photos.map((p) => {
        const im = imgs[`../assets/gallery/${p.file}`]?.default;
        return im && (
          <figure class="card shot" style="margin:0">
            <a href={im.src} class="zoom" data-caption={p.caption}>
              <Image src={im} alt={p.alt} widths={[400, 800]} sizes="(max-width: 600px) 100vw, (max-width: 860px) 50vw, 360px" />
            </a>
            <figcaption class="cap">
              <span class="meta"><span class="tag tag-date">{p.tag}</span>{p.date}</span>
              <p>{p.caption}</p>
            </figcaption>
          </figure>
        );
      })}
    </div>
  </div>
</Layout>
